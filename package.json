{
  "name": "broccoli",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "BROCCOLI: Kingdom Clash \u2014 original real-time strategy game",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "sim:ai": "tsx scripts/ai-sim.ts 100",
    "server": "tsx apps/server/src/server.ts",
    "test:online": "node scripts/e2e-online.mjs",
    "lint:server": "tsc --noEmit -p tsconfig.server.json",
    "test:artpack": "node scripts/test-artpack.mjs",
    "perf": "node scripts/perf.mjs",
    "art:templates": "node scripts/export-art.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "@types/node": "^22.10.0"
  }
}